import { Template } from "../template/template"
import { Usage } from "../../usage/usage"
import { LlmCredential } from "../../llm/llm"
import { PaddockScenario } from "../../paddock/scenario/scenario"
import { PaddockEvaluation } from "../../paddock/evaluation/evaluation"
import { ChatSession } from "../../chat/chat"
import { AgentShareLink } from "../shareLink/shareLink"
import { AgentPeer } from "../peer/peer"
import { AgentLimit, AgentLoadMinute } from "../limit/agentLimit"
import { AgentDelegation } from "../peer/delegation"
import { AgentToolListing } from "../toolCatalog/toolCatalog"
import { FileChangeProposal } from "../file/file"
import { AgentEvent } from "../event/agentEvent"
import { AgentIncident } from "../event/agentEvent"
import { AgentPin } from "../pin/agentPin"
import { UserAgentAccessEntry } from "../../user/agentAccess/agentAccess"

model Agent {
  id              String         @id @default(uuid())
  name            String
  templateId      String
  template        Template       @relation(fields: [templateId], references: [id])
  llmCredentialId String?
  llmCredential   LlmCredential? @relation(fields: [llmCredentialId], references: [id], onDelete: SetNull)
  status          String         @default("pending")
  // Human-readable reason accompanying status='failed' or 'unreachable';
  // cleared on every transition to any other status. Also written stand-alone
  // during 'deploying' when bridle settings are empty (deploy-time warning).
  statusReason    String?
  workflowId      String?
  // Set once, on the first successful workflow submit. Null ⇒ never deployed.
  firstDeployedAt DateTime?
  // Anchor of the deploy grace window: written together with every
  // status='deploying' transition. Drift detection won't fail a pod-less
  // agent while `now - lastDeployStartedAt` is inside the grace period.
  lastDeployStartedAt DateTime?
  // 'initial' (first-ever deploy) | 'restart' (any subsequent deploy).
  // Server-derived launch context so the UI can tell a first start from a
  // restart even after a page reload.
  lastLaunchContext String?
  // Sync-conflict markers (CLEAN-50). The pod pulls its working copy from S3
  // at boot and pushes a delta back only on Sync; S3 objects modified after
  // max(lastSyncAt, lastPullAt - margin) are "at risk" of being overwritten.
  // lastPullAt = bridle socket connect (upper bound of the boot pull);
  // lastSyncAt = sync_done received. Null on agents not restarted since this
  // feature shipped — the guard then skips the check (pre-feature behavior).
  lastPullAt      DateTime?
  lastSyncAt      DateTime?
  config          Json           @default("{}")
  resources       Json           @default("{\"cpu\": \"500m\", \"memory\": \"512Mi\"}")
  debugEnabled    Boolean        @default(false)
  isPublic        Boolean        @default(false)
  allowedOrigins  String[]       @default([])
  knowledgeIds    String[]       @default([])
  isAdmin         Boolean        @default(false)
  // The console account that created this agent (CLEAN-232): written once at
  // creation, never updated. Null for an agent created by a trusted party
  // (the Ranch admin agent on its own schedule) and for every agent that
  // existed before the column. A bare id on purpose, no relation: the agent
  // outlives the account, and "Removed account" is told from a user row that
  // is no longer there. Read by AgentPermissionService.canManage.
  createdById     String?
  // When the running pod last received this agent's peer list over MCP, and
  // the hash of the peer row ids it received. armed = stored hash equals the
  // hash of the current peer set; recorded by AskAgentTool (CLEAN-95).
  peersServedAt   DateTime?
  peersServedHash String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  usages             Usage[]
  paddockScenarios   PaddockScenario[]
  paddockEvaluations PaddockEvaluation[]
  chatSessions       ChatSession[]
  // At most one public share link per agent (CLEAN-66).
  shareLink          AgentShareLink?
  // Request limits and per-minute load (CLEAN-224). No AgentLimit row means
  // limits are off. Deliberately not columns here: see agentLimit.prisma.
  limit              AgentLimit?
  loadMinutes        AgentLoadMinute[]
  // Agents this one may delegate to, and the ones that may delegate to it
  // (CLEAN-74). Directed: the two lists are unrelated.
  peers              AgentPeer[]         @relation("AgentPeerCaller")
  peerOf             AgentPeer[]         @relation("AgentPeerTarget")
  delegations        AgentDelegation[]
  // Last tools/list served to this agent's pod (CLEAN-109).
  toolListing        AgentToolListing?
  fileProposals      FileChangeProposal[]
  // Failure reports and the incidents they group into (CLEAN-139). Both keep
  // their rows when the agent is deleted (SetNull) — history outlives it.
  agentEvents        AgentEvent[]
  agentIncidents     AgentIncident[]
  // Which accounts have this agent on their allowed or denied list, and who
  // pinned it (CLEAN-231). Both go with the agent (Cascade): deleting an
  // agent never leaves an entry or a pin behind.
  accessEntries      UserAgentAccessEntry[]
  pins               AgentPin[]
}
