import { Agent } from "../agent/agent"

// One report that something happened to an agent (CLEAN-139). Written by an
// outside sender through POST /agent-events, or by Ranch itself when its own
// watch moves an agent to 'failed' / 'unreachable'. An event informs: it never
// writes the agent's status.
model AgentEvent {
  id          String         @id @default(uuid())
  // null when the id matched no agent, or the agent was deleted since.
  agentId     String?
  agent       Agent?         @relation(fields: [agentId], references: [id], onDelete: SetNull)
  // The id exactly as the sender gave it — kept when nothing matched.
  agentRef    String
  // The agent's name when the event arrived; survives the agent's deletion.
  agentName   String?
  // 'failed' | 'unreachable' | 'recovered'. Outside senders may send
  // 'failed' and 'recovered'; 'unreachable' is Ranch's own.
  status      String
  // The cause in the sender's words, shown as received.
  reason      String?        @db.Text
  // 'ranch' | 'external' — who saw it.
  witness     String
  // The API key that posted it. No relation on purpose: revoking a key
  // deletes its row and must not touch history.
  apiKeyId    String?
  // The key's name at the time, or 'Ranch'.
  senderName  String
  // The body's `source` — detail only, never identity.
  tool        String?
  // What Ranch held for the agent when the event arrived.
  ranchStatus String?
  // 'opened' | 'joined' | 'suppressed_stopped' | 'suppressed_starting' |
  // 'unmatched' | 'evidence' — what the event did, decided once on arrival.
  outcome     String
  incidentId  String?
  incident    AgentIncident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  // The sender's `datetime`, else receivedAt.
  occurredAt  DateTime
  receivedAt  DateTime       @default(now())
  // Makes a sender's retry one event. NULL when the sender gave neither an
  // eventId nor a datetime — Postgres allows any number of NULLs.
  dedupeKey   String?        @unique

  @@index([receivedAt])
  @@index([agentId, receivedAt])
  // The flood count: this key's events of the last minute.
  @@index([apiKeyId, receivedAt])
  @@index([incidentId])
}

// One stretch of trouble for one agent, from the first failure until Ranch
// has seen the agent running for ten quiet minutes. It is what the team is
// told about: once when it opens, once when it closes.
model AgentIncident {
  id             String              @id @default(uuid())
  agentId        String?
  agent          Agent?              @relation(fields: [agentId], references: [id], onDelete: SetNull)
  agentName      String
  // The agent id while the incident is open, NULL once closed. Unique, so
  // "at most one open incident per agent" is a database invariant: two
  // senders, or two API replicas, reporting the same failure in the same
  // second cannot open two.
  openKey        String?             @unique
  // The first failure's status and reason.
  status         String
  reason         String?             @db.Text
  // The short handle people use: "#12". A sequence, so two replicas opening
  // at the same instant get two numbers; gaps are fine (CLEAN-165).
  number         Int                 @unique @default(autoincrement())
  // The destination's kind when the incident opened: 'webhook' | 'bot' |
  // NULL (none was set). An incident finishes on the transport it started
  // on, whatever the owner switches to later.
  transport      String?
  // The bot transport's root message in the channel, once posted. `slackTs`
  // set ⇒ never post another root for this incident.
  slackChannel   String?
  slackTs        String?
  // The one reaction the bot has on the root right now; swapped, never
  // stacked.
  slackReaction  String?
  // Next `seq` for this incident's outbox rows — delivered in that order.
  notificationSeq      Int           @default(0)
  // When the last "Failed again" reply was queued: at most one a minute.
  lastJoinedNotifiedAt DateTime?
  // A report was swallowed by that minute rule; the sweep rewrites the root
  // so its count catches up, then clears this.
  rootStale      Boolean             @default(false)
  // True once any event of the incident was witnessed by Ranch itself.
  ranchWitnessed Boolean             @default(false)
  // How many reports the incident holds and who sent them, first reporter
  // first. Kept on the row and updated as each report is attached: the list
  // of incidents is re-read every few seconds by every open console, and
  // counting through AgentEvent made that read grow with the history —
  // 160 ms a request at 60 000 reports, measured.
  eventCount     Int                 @default(0)
  witnesses      String[]            @default([])
  openedAt       DateTime
  // receivedAt of the newest failure event; a new one restarts the quiet period.
  lastFailureAt  DateTime
  // When Ranch last saw the agent turn 'running'; cleared by a new failure.
  upSince        DateTime?
  closedAt       DateTime?
  // 'recovered' | 'unconfirmed' | 'stopped' | 'deleted'
  resolution     String?

  events         AgentEvent[]
  notifications  AgentNotification[]

  @@index([agentId, openedAt])
  // The all-agents list, newest first.
  @@index([openedAt])
  @@index([closedAt])
}

// One message about an incident, with its delivery. An outbox: the row is
// written with the incident, and a worker sends it, so the sender's answer
// never waits for Slack and Slack being down loses nothing.
model AgentNotification {
  id            String        @id @default(uuid())
  incidentId    String
  incident      AgentIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  // 'opened' | 'joined' | 'running' | 'closed'. The webhook transport only
  // ever queues the first and the last; the bot says something at every
  // step (CLEAN-165).
  kind          String
  // Position inside the incident: rows of one incident are delivered in
  // this order, so a thread never shows "Resolved" above "Failed again".
  seq           Int
  // What the message says, fixed when it was queued. No secret in it.
  payload       Json
  // 'pending' | 'sent' | 'failed' | 'skipped'
  status        String        @default("pending")
  attempts      Int           @default(0)
  nextAttemptAt DateTime      @default(now())
  // A replica's claim on the row while it sends.
  lockedUntil   DateTime?
  // The destination's status and answer, cut short. Never the address.
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime      @default(now())

  // One opening and one closing per incident still hold: they are queued by
  // the two writes that can happen once (openIncident, closeIncident).
  @@unique([incidentId, seq])
  @@index([status, nextAttemptAt])
}

// Where the team is told. One row per install (id = 'slack'). `webhookUrl`
// and `botToken` are secrets: read only by the notifiers, never returned by
// a route, a tool or a log line. They live here and not in Setting because
// GET /settings hands every value back to the console.
model AgentEventDestination {
  id                String    @id
  // 'webhook' — a Slack incoming webhook, one message per event;
  // 'bot' — a Slack bot token + channel, one message per incident with its
  // story in the thread (CLEAN-165). Exactly one kind's fields are set.
  kind              String
  webhookUrl        String?
  botToken          String?
  // Not a secret: shown back to the owner.
  channelId         String?
  // Last four characters of whichever secret is set, for "which one is this".
  hint              String
  updatedBy         String
  updatedAt         DateTime  @updatedAt
  lastDeliveryAt    DateTime?
  lastDeliveryOk    Boolean?
  lastDeliveryError String?
}
