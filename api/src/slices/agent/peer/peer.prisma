import { Agent } from "../agent/agent"
import { AgentDelegation } from "./delegation"

// One directed peer connection (CLEAN-74): "agentId holds peerAgentId's card
// and may delegate to it". The reverse direction is a separate row — connecting
// B to A says nothing about A's own peers.
//
// The token is stored in plaintext, like the share link and unlike an API key,
// because here the API is both issuer AND presenter: `ask_agent` runs inside
// the API and must read the credential back to present it to the peer. A
// hash-only store would force a second, recoverable secret alongside it.
// Never returned by a DTO, never logged. See research.md R4.
//
// cardSnapshot is the peer's A2A card as read at connect or last Refresh. The
// delegating agent reasons from the snapshot, never from a live read, so a peer
// editing its description mid-turn cannot change behaviour until someone
// presses Refresh.
model AgentPeer {
  id            String    @id @default(uuid())
  // The caller.
  agentId       String
  agent         Agent     @relation("AgentPeerCaller", fields: [agentId], references: [id], onDelete: Cascade)
  // The peer. Null ⇔ origin='external': the agent lives outside this
  // installation and is known only by its card URL (CLEAN-95).
  peerAgentId   String?
  peerAgent     Agent?    @relation("AgentPeerTarget", fields: [peerAgentId], references: [id], onDelete: Cascade)
  // 'internal' | 'external'. External rows are imported by URL and deduped on
  // (agentId, cardUrl) among shared rows and on (agentId, cardUrl,
  // ownerUserId) among personal ones: two partial unique indexes, see the
  // CLEAN-236 migration.
  origin        String    @default("internal")
  // `ap_` + 32 random bytes base64url (~256 bits). Scoped to this pair only;
  // deleting the row revokes it. Null on external rows: the foreign agent
  // never calls us through this connection.
  token         String?   @unique
  // Bearer we present to an external agent. Write-only: no DTO carries it.
  outboundToken String?
  cardSnapshot  Json
  cardUrl       String
  cardReadAt    DateTime
  // Who made the connection (CLEAN-236). Null: made before it was recorded,
  // or by an account that is gone. No relation, like Agent.createdById.
  createdById   String?
  // Internal rows only. False: the peer serves the people who reach it.
  // True: it serves every caller of `agentId`, set by somebody who manages
  // both agents (`openedById`, `openedAt`).
  openToVisitors Boolean  @default(false)
  openedById    String?
  openedAt      DateTime?
  // External rows only. Set: the one person the connection serves. Null: it
  // serves every caller of `agentId`.
  ownerUserId   String?
  // Set by the CLEAN-236 migration on rows that existed before it; cleared
  // the first time the visitors setting of the row is saved.
  needsReview   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  delegations AgentDelegation[]

  // One connection per direction (NULL peerAgentId rows don't collide here;
  // external dedup is the two partial unique indexes named above).
  @@unique([agentId, peerAgentId])
  @@index([agentId])
  @@index([peerAgentId])
  @@index([agentId, cardUrl])
}
