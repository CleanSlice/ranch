import { Agent } from "../agent/agent"

// Request limits for one agent (CLEAN-224). One row per agent that has
// limits; no row means "off", which is the default for every agent. Kept
// apart from Agent on purpose: the whole Agent record is readable in places
// limit values must never reach (the status stream, AgentDto).
// The one anonymous reader is a share visitor, who is told the configured
// values through `/share/resolve` and nothing about usage (CLEAN-237).
model AgentLimit {
  agentId     String   @id
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  // Requests accepted in any 60 seconds / 60 minutes / 24 hours. Null = this
  // window is not limited. At least one is set, otherwise the row is deleted.
  perMinute   Int?
  perHour     Int?
  perDay      Int?
  // JWT `sub` of the console user who last changed it; null for a change that
  // carried no user.
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Requests per agent per minute. Written for every agent that gets traffic,
// limited or not: it is what survives a restart, what the last-hour chart
// draws and what the 30-day peaks are computed from. Counts only — no message
// content and nothing about who sent a request. Rows exist only for minutes
// with traffic and are pruned after 30 days.
model AgentLoadMinute {
  agentId         String
  agent           Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  // Start of the minute, UTC.
  minute          DateTime
  accepted        Int      @default(0)
  refused         Int      @default(0)
  // Which window set the wait of a refusal.
  refusedByMinute Int      @default(0)
  refusedByHour   Int      @default(0)
  refusedByDay    Int      @default(0)
  // Operator and agent-to-agent requests: seen, never counted toward limits.
  exempt          Int      @default(0)

  @@id([agentId, minute])
  @@index([minute])
}

// Requests per agent per UTC day (CLEAN-261): what remains of the minute rows
// after they are pruned at 30 days, so a 90-day view and its comparison with
// the 90 days before can still say how many requests were refused. Incremented
// by the same deltas, in the same transaction, as the minute row, so a day can
// only equal the sum of its minutes. Kept 400 days: the longest period shown,
// its predecessor, and a year's margin for a yearly view (spec 038, FR-030).
// Counts only, like the minute rows.
model AgentLoadDay {
  agentId  String
  agent    Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  // Start of the day, UTC.
  day      DateTime
  accepted Int      @default(0)
  refused  Int      @default(0)
  exempt   Int      @default(0)

  @@id([agentId, day])
  @@index([day])
}
