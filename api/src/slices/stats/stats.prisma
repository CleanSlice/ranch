// What the product knows about one figure's history (CLEAN-261). One row per
// figure in the registry (`domain/figures/`), written once, the first time the
// figure is seen at boot: the moment live recording starts for a figure that
// has a recorder, the earliest row of its source for a figure read in place.
// It is never moved later. A period view that starts before `completeSince`
// carries a note, so a block says "counted since …" instead of showing a
// smaller number as if it were the whole period (spec 038, FR-028).
model StatFigure {
  key           String   @id
  completeSince DateTime
  updatedAt     DateTime @updatedAt
}
