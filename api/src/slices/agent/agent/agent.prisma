import { Template } from "../template/template"
import { Usage } from "../../usage/usage"
import { LlmCredential } from "../../llm/llm"
import { PaddockScenario } from "../../paddock/scenario/scenario"
import { PaddockEvaluation } from "../../paddock/evaluation/evaluation"
import { ChatSession } from "../../chat/chat"

model Agent {
  id              String         @id @default(uuid())
  name            String
  templateId      String
  template        Template       @relation(fields: [templateId], references: [id])
  llmCredentialId String?
  llmCredential   LlmCredential? @relation(fields: [llmCredentialId], references: [id], onDelete: SetNull)
  status          String         @default("pending")
  // Human-readable reason accompanying status='failed' or 'unreachable';
  // cleared on every transition to any other status. Also written stand-alone
  // during 'deploying' when bridle settings are empty (deploy-time warning).
  statusReason    String?
  workflowId      String?
  // Set once, on the first successful workflow submit. Null ⇒ never deployed.
  firstDeployedAt DateTime?
  // Anchor of the deploy grace window: written together with every
  // status='deploying' transition. Drift detection won't fail a pod-less
  // agent while `now - lastDeployStartedAt` is inside the grace period.
  lastDeployStartedAt DateTime?
  // 'initial' (first-ever deploy) | 'restart' (any subsequent deploy).
  // Server-derived launch context so the UI can tell a first start from a
  // restart even after a page reload.
  lastLaunchContext String?
  // Sync-conflict markers (CLEAN-50). The pod pulls its working copy from S3
  // at boot and pushes a delta back only on Sync; S3 objects modified after
  // max(lastSyncAt, lastPullAt - margin) are "at risk" of being overwritten.
  // lastPullAt = bridle socket connect (upper bound of the boot pull);
  // lastSyncAt = sync_done received. Null on agents not restarted since this
  // feature shipped — the guard then skips the check (pre-feature behavior).
  lastPullAt      DateTime?
  lastSyncAt      DateTime?
  config          Json           @default("{}")
  resources       Json           @default("{\"cpu\": \"500m\", \"memory\": \"512Mi\"}")
  debugEnabled    Boolean        @default(false)
  isPublic        Boolean        @default(false)
  allowedOrigins  String[]       @default([])
  knowledgeIds    String[]       @default([])
  isAdmin         Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  usages             Usage[]
  paddockScenarios   PaddockScenario[]
  paddockEvaluations PaddockEvaluation[]
  chatSessions       ChatSession[]
}
