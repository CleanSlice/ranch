# ============================================
# ADMIN APP
# ============================================

# API connection
# NUXT_PUBLIC_API_URL feeds runtimeConfig.public.apiUrl, which the
# apiBaseUrl plugin reads to set the axios baseURL on the client.
# (Plain API_URL is NOT exposed to the client bundle.)
NUXT_PUBLIC_API_URL=http://localhost:3333
API_URL=http://localhost:3333

# App console
# Share links created from admin open the app's /share page, so admin needs
# the app's public address. Optional locally (defaults to http://localhost:3000),
# required in a deployment.
NUXT_PUBLIC_APP_URL=http://localhost:3000
