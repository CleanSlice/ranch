import { Knowledge } from "../knowledge/knowledge"

model Source {
  id            String    @id @default(uuid())
  knowledgeId   String
  knowledge     Knowledge @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)
  type          String
  name          String
  url           String?
  mimeType      String?
  content       String?
  sizeBytes     Int?
  lightragDocId String?
  // Honest per-source ingestion state (queued | processing | indexed |
  // failed). lightragDocId only means "handed over"; this means what it says.
  indexState    String    @default("queued")
  indexError    String?
  indexedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([knowledgeId])
  @@index([lightragDocId])
  @@index([indexState])
}
