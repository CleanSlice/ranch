import { LlmCredential } from "../llm/llm"

model Usage {
  id              String         @id @default(uuid())
  // A plain column, not a relation (CLEAN-261): what an agent spent stays
  // spent after the agent is deleted, so a past period's total does not
  // shrink (spec 038, FR-031). The same choice as
  // ChatMessageSource.knowledgeId, for the same reason.
  agentId         String
  // The agent's name when the usage was reported, so a deleted agent's rows
  // can still be shown by name. Null on rows written before this column for
  // an agent that was already gone.
  agentName       String?
  llmCredentialId String?
  llmCredential   LlmCredential? @relation(fields: [llmCredentialId], references: [id], onDelete: SetNull)
  model           String
  date            DateTime
  inputTokens     Int            @default(0)
  outputTokens    Int            @default(0)
  callCount       Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([agentId, model, date])
  @@index([agentId])
  @@index([date])
}
